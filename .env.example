# ---------------------------------------------------------------------------
# Beat Analysis Engine — environment configuration
# Copy to .env and adjust as needed. All values have working defaults.
# ---------------------------------------------------------------------------

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS (comma-separated). "*" allows all origins (suitable for local demo).
CORS_ORIGINS=*

# Directories
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts
CHECKPOINT_DIR=./data/checkpoints

# Upload / audio limits
MAX_UPLOAD_MB=500
MIN_AUDIO_SECONDS=0.5
MAX_AUDIO_SECONDS=1800

# Concurrency (CPU-bound — 1 at a time is the safe default)
MAX_CONCURRENT_ANALYSES=1
JOB_QUEUE_MAX=4
JOB_TTL_SECONDS=3600

# Model weights
# If ALLOW_MODEL_DOWNLOAD=false, only local checkpoints in CHECKPOINT_DIR
# or the torch hub cache will be used.
ALLOW_MODEL_DOWNLOAD=true
CHECKPOINT_BASE_URL=https://cloud.cp.jku.at/public.php/dav/files/7ik4RrBKTS273gp
